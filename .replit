modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-test"

[[workflows.workflow]]
name = "admin-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/admin test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = "587"
SMTP_FROM = "noreply@mylocaltrade.co.uk"
SMTP_USER = "noreply@mylocaltrade.co.uk"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_qbWESyJrXDmlctafkOtDEaJqYTW"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_BIVAfGioOyQNZKAYqDNZkTtBnOk"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_qHukXmrQAVympYwzJvgUmuuFcrW"
REVENUECAT_PROJECT_ID = "proja2b11716"
UNIVERSAL_LINK_BASE_URL = "https://mylocaltrade.co.uk"

[userenv.production]
ADMIN_BOOTSTRAP_EMAIL = "lucian.sabau@serviceproviderltd.co.uk"

[nix]
channel = "stable-25_05"
packages = ["zip"]

[objectStorage]
defaultBucketID = "replit-objstore-5515aada-a453-4808-bfcb-fd2f2b5f8755"
